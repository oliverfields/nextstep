#!/bin/bash

# Function to print a warning message (Yellow)
warning() {
  echo -e "\033[33mWarning: $1\033[0m" >&2
}

# Function to print an error message and exit with status 1 (Red)
error() {
  echo -e "\033[31mError: $1\033[0m" >&2
  exit 1
}

# Help message
show_help() {
  echo "Usage: $0 [-e|--edit] [-h|--help] [-t|--track <path>] [-u|--untrack <path>] [-l|--list-steps] [<path>]"
  echo ""
  echo "NEXTSTEP rules:"
  echo "  Only files whose name is exactly 'NEXTSTEP' are valid."
  echo "  Ordering is important, both of steps in NEXTSTEP files and paths in tracking file."
  echo "  A step is a single line that starts with 'NEXTSTEP '"
  echo "  Markdown headings group steps into projects; the default view shows the first step per heading."
  echo ""
  echo "Options:"
  echo "  -e, --edit               Edit the tracking file"
  echo "  -h, --help               Show this help message"
  echo "  -l, --list-steps <path>  List all steps found in <path>"
  echo "  -t, --track <path>       Add a NEXTSTEP file to tracking file(name must be NEXTSTEP)"
  echo "  -u, --untrack <path>     Remove a NEXTSTEP file from tracking file"
  echo ""
  echo "Example: $ nextstep -> list next step for each NEXTSTEP file in tracking file"
  echo "Example: $ nextstep /path/to/NEXTSTEP -> open file on next step line"
  echo "Example: $ nextstep -l /path/to/NEXTSTEP -> list tasks in file"
  echo ""
  exit 0
}

safe_commit() {
    local NEXTSTEP_FILE="$1"

    if [ -z "$NEXTSTEP_FILE" ]; then
        error "usage: safe_commit <task_file>"
    fi

    # Run every git command against the FILE'S repository, not the directory
    # nextstep was launched from -- the selected file often lives in a different
    # repo. Pathspecs are relative to "$dir" (so just the basename); --name-only
    # output is repo-relative, so "$rel" is used for those comparisons.
    local dir base rel current_branch STAGED_OTHERS
    dir="$(cd "$(dirname "$NEXTSTEP_FILE")" 2>/dev/null && pwd)" || exit 0
    base="$(basename "$NEXTSTEP_FILE")"

    # Ensure the file is inside a git repo
    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

    # Nothing changed in the working tree? Then there's nothing to commit -- opening
    # a file to read it, or quitting without saving, is a no-op. Bail out here,
    # before any network access, so browsing stays fast and side-effect free.
    if git -C "$dir" diff --quiet -- "$base"; then
        return 0
    fi

    # Repo-relative path, matching how the file appears in --name-only output
    rel="$(git -C "$dir" rev-parse --show-prefix)$base"

    # Refuse if the task file is already staged -- let the user handle that manually
    if git -C "$dir" diff --cached --name-only | grep -qFx "$rel"; then
        error "Task file $rel has staged changes. Please unstage or commit them manually."
    fi

    # Refuse if anything else is staged -- we only want to commit the task file
    STAGED_OTHERS="$(git -C "$dir" diff --cached --name-only | grep -vFx "$rel" || true)"
    if [ -n "$STAGED_OTHERS" ]; then
        error "Other files are staged. Commit or stash them first:\n$STAGED_OTHERS"
    fi

    git -C "$dir" fetch --quiet origin >/dev/null 2>&1
    current_branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"

    # Has the remote moved ahead on this file? Compare our committed version against
    # the remote branch's version of the same path (revisions before '--', path
    # after). Working-tree edits are ignored on purpose -- those are what we're about
    # to commit. Skip if the remote branch doesn't exist yet.
    if git -C "$dir" rev-parse --verify --quiet "origin/$current_branch" >/dev/null; then
        if ! git -C "$dir" diff --quiet HEAD "origin/$current_branch" -- "$base"; then
            error "Remote task file $rel has changes. Please pull and resolve before committing."
        fi
    fi

    # Unresolved merge conflict on the file?
    if [ -n "$(git -C "$dir" ls-files -u -- "$base")" ]; then
        error "$rel has merge conflicts. Resolve before committing."
    fi

    git -C "$dir" add -- "$base"                                >/dev/null 2>&1 || error "syncing git: $dir"
    git -C "$dir" commit --quiet -m "Update NEXTSTEP file $rel" >/dev/null 2>&1 || error "syncing git: $dir"
    git -C "$dir" push --quiet                                  >/dev/null 2>&1 || error "syncing git: $dir"
}

# Extract the text of an ATX markdown heading line.
# Sets `heading_result` and returns 0 if $1 is a heading; returns 1 otherwise.
parse_heading() {
  local line="$1"
  [[ "$line" =~ ^#+[[:space:]]+(.*)$ ]] || return 1
  local h="${BASH_REMATCH[1]}"
  # Strip optional CommonMark closing hashes (space-separated, at end of line)
  [[ "$h" =~ ^(.*[^[:space:]#])[[:space:]]+#+[[:space:]]*$ ]] && h="${BASH_REMATCH[1]}"
  # Trim trailing whitespace
  h="${h%"${h##*[![:space:]]}"}"
  heading_result="$h"
  return 0
}

config_file="$HOME/.config/nextstep/config"
tracking_file="$HOME/.config/nextstep/tracking"

list_type="next_step"

# ---- Parse command-line arguments ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--edit)
      if [ ! -f "$tracking_file" ]; then
        mkdir -p "$(dirname "$tracking_file")"
        touch "$tracking_file"
      fi
      vim "$tracking_file"
      exit 0
      ;;

    -h|--help)
      show_help
      ;;

    # ---------------- TRACK ----------------
    -t|--track)
      shift
      track_path="$1"
      if [ -z "$track_path" ]; then
        error "Missing argument for -t|--track"
      fi

      # Convert relative → absolute
      if [[ "$track_path" != /* ]]; then
        track_path="$PWD/$track_path"
      fi

      # ---- enforce filename is exactly NEXTSTEP ----
      if [[ "$(basename "$track_path")" != "NEXTSTEP" ]]; then
        error "Refusing to track: filename must be exactly 'NEXTSTEP'"
      fi

      # Ensure file exists
      if [ ! -f "$track_path" ]; then
        touch "$track_path" || error "Unable to create: $track_path"
      fi

      mkdir -p "$(dirname "$tracking_file")"
      touch "$tracking_file"

      if grep -Fxq "$track_path" "$tracking_file"; then
        warning "Path already tracked: $track_path"
        exit 0
      fi

      echo "$track_path" >> "$tracking_file"
      exit 0
      ;;

    # ---------------- UNTRACK ----------------
    -u|--untrack)
      shift
      untrack_path="$1"
      if [ -z "$untrack_path" ]; then
        error "Missing argument for -u|--untrack"
      fi

      # Convert relative → absolute
      if [[ "$untrack_path" != /* ]]; then
        untrack_path="$PWD/$untrack_path"
      fi

      # ---- enforce filename is exactly NEXTSTEP ----
      if [[ "$(basename "$untrack_path")" != "NEXTSTEP" ]]; then
        error "Cannot untrack: filename must be exactly 'NEXTSTEP'"
      fi

      if [ ! -f "$tracking_file" ]; then
        warning "Projects file not found at $tracking_file"
        exit 0
      fi

      if ! grep -Fxq "$untrack_path" "$tracking_file"; then
        warning "Path not tracked: $untrack_path"
        exit 0
      fi

      grep -Fxv "$untrack_path" "$tracking_file" > "$tracking_file.tmp" &&
      mv "$tracking_file.tmp" "$tracking_file"
      exit 0
      ;;
    -l|--list-steps)
      list_steps=1
      ;;
    *)
      file_path="$1"
      list_type="file"
      ;;
  esac
  shift
done

# ---- Existing nextstep NEXTSTEP-scanning logic ----

if [ ! -f "$tracking_file" ]; then
  error "Projects file not found at $tracking_file"
fi

git_commit="$(grep '^git_commit=' "$config_file")"
git_commit="${git_commit#git_commit=}"

if [ "$list_type" = "next_step" ]; then
  selection="$(
  while IFS= read -r file_path; do
    [[ -z "$file_path" || "$file_path" =~ ^[[:space:]]*$ || "$file_path" =~ ^# ]] && continue


    # ---- enforce filename is exactly NEXTSTEP ----
    if [[ "$(basename "$file_path")" != "NEXTSTEP" ]]; then
      warning "Skipping non-NEXTSTEP file in projects file: $file_path"
      continue
    fi

    if [ -f "$file_path" ]; then
      line_number=0
      [[ "$file_path" =~ ^"$HOME"(/|$) ]] && file_path_display="~${file_path#$HOME}" || file_path_display="$file_path"

      file_path_display="${file_path_display%/NEXTSTEP}"

      # One step per heading: emit the first NEXTSTEP after each heading.
      # A heading section runs until the next heading of any level. Steps before
      # the first heading form an anonymous section (heading column omitted).
      # Headings with no step are simply skipped -- completed projects leave
      # step-less headings behind, and those are not worth listing.
      first_task="$(
        last_heading=""
        emitted=0
        while IFS= read -r line; do
          let line_number=line_number+1
          if parse_heading "$line"; then
            last_heading="$heading_result"
            emitted=0
            continue
          fi
          if [[ "$line" == NEXTSTEP\ * && "$emitted" -eq 0 ]]; then
            task="${line#NEXTSTEP }"
            if [[ -n "$last_heading" ]]; then
              echo -e "\033[36m$file_path_display:$line_number:\033[35m$last_heading:\033[37m$task"
            else
              echo -e "\033[36m$file_path_display:$line_number:\033[37m$task"
            fi
            emitted=1
          fi
        done < "$file_path")"
    else
      error "File not found: $file_path"
    fi

    if [ "$first_task" = "" ]; then
      echo -e "\033[36m$file_path_display:1:\033[31m⚠️NO NEXTSTEP"
    else
      echo -e "$first_task"
    fi

  done < "$tracking_file" | fzy --lines=$(($(tput lines)-2)) )"

  [ "$selection" = "" ] && exit 0

  selection="$(echo $selection | sed 's/\x1b\[[0-9;]*m//g')"
  IFS=':' read -r file_path line_number task <<< "$selection"
  [[ "$file_path" =~ ^~ ]] && file_path="$HOME${file_path#?}"
  file_path="$file_path/NEXTSTEP"

  if [ "$line_number" != "" ]; then
    vim +$line_number "$file_path"
  else
    vim "$file_path"
  fi
fi


if [[ "$list_type" = "file" && $list_steps -eq 1 ]]; then
  # ---- enforce filename is exactly NEXTSTEP ----
  if [[ "$(basename "$file_path")" != "NEXTSTEP" ]]; then
    error "File must be called NEXTSTEP"
  fi

  selection="$(
  line_number=0
  last_heading=""
  while IFS= read -r line; do
    let line_number=line_number+1
    if parse_heading "$line"; then
      last_heading="$heading_result"
      continue
    fi
    if [[ "$line" == NEXTSTEP\ * ]]; then
      if [[ -n "$last_heading" ]]; then
        echo -e "\033[36m$line_number:\033[35m$last_heading:\033[37m$line"
      else
        echo -e "\033[36m$line_number:\033[37m$line"
      fi
    fi
  done < "$file_path" | fzy --lines=$(($(tput lines)-2)) )"

  [ "$selection" = "" ] && exit 0

  selection="$(echo $selection | sed 's/\x1b\[[0-9;]*m//g')"
  IFS=':' read -r line_number task <<< "$selection"

  if [ "$line_number" != "" ]; then
    vim +$line_number "$file_path"
  else
    vim "$file_path"
  fi
elif [ "$list_type" = "file" ]; then

  # ---- enforce filename is exactly NEXTSTEP ----
  if [[ "$(basename "$file_path")" != "NEXTSTEP" ]]; then
    error "Only files named exactly 'NEXTSTEP' are valid"
  fi

  if [ -f "$file_path" ]; then
    line_number=0
    while IFS= read -r line; do
      let line_number=line_number+1
      [[ "$line" == NEXTSTEP\ * ]] && break
    done < "$file_path"
  else
    error "File not found: $file_path"
  fi

  vim +$line_number "$file_path"
fi

[ "$git_commit" = "yes" ] && safe_commit "$file_path"
